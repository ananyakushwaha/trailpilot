DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trailos?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"

# Optional integrations. Each feature works without these (falls back to
# manual entry / logging), but wiring them up enables live sending.

# AI-assisted itinerary drafts (Anthropic). Falls back to a template-based
# draft generator if unset.
ANTHROPIC_API_KEY=""

# WhatsApp Cloud API (Meta). Falls back to logging the message instead of
# sending it if unset.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Email sending via Resend. Falls back to logging the email instead of
# sending it if unset.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TrailOS <onboarding@resend.dev>"

# Razorpay online payment orders. Manual payment entry (cash/UPI/bank
# transfer) always works regardless of these.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
